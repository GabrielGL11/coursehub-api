# Variables del entorno Docker de PRÁCTICA. Copiar a `.env.docker`:
#   Copy-Item .env.docker.example .env.docker     (PowerShell)
#   cp .env.docker.example .env.docker            (bash)
# `.env.docker` NO se sube a Git. Aquí solo hay nombres y valores de ejemplo,
# nunca credenciales reales.

# --- Base de datos (obligatorias) -------------------------------------------
DATABASE_USER=coursehub
DATABASE_PASSWORD=cambia-esta-clave-local
DATABASE_NAME=coursehub

# --- Autenticación (obligatoria) --------------------------------------------
# Mínimo 32 caracteres. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio-de-practica
JWT_EXPIRES_IN=15m

# --- Opcionales --------------------------------------------------------------
# Puerto del equipo donde se publica la API (dentro del contenedor siempre es 3000).
API_HOST_PORT=3000

# SOLO práctica: crea las tablas al iniciar. No hay migraciones en este curso.
# En un despliegue real debe ser false y el esquema se gestiona con migraciones.
DATABASE_SYNCHRONIZE=true

# Límite de solicitudes por IP: THROTTLE_LIMIT solicitudes cada THROTTLE_TTL_MS ms.
# Déjalo en 20 salvo durante la prueba de carga local (ver README, Sesión 30),
# y vuelve a este valor al terminar.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
