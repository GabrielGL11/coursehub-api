NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=coursehub
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-local-password
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=15m

# --- Semana 15 (opcionales; los valores por defecto son los seguros) ---------
# Crea las tablas al iniciar. Solo para práctica; en desarrollo ya es automático.
# DATABASE_SYNCHRONIZE=false
# Límite de solicitudes por IP: THROTTLE_LIMIT cada THROTTLE_TTL_MS milisegundos.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=20
