# Configuración EXCLUSIVA para las pruebas e2e. Copiar a `.env.test`:
#   Copy-Item .env.test.example .env.test
# `.env.test` no se sube a Git (debe estar en .gitignore).
#
# IMPORTANTE: el nombre de la base debe terminar en `_test`. Las pruebas
# borran y recrean las tablas de esa base y se niegan a ejecutarse en otra.
NODE_ENV=test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=coursehub_test
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_password_local
JWT_SECRET=secreto-solo-para-pruebas-e2e-no-usar-en-produccion
JWT_EXPIRES_IN=15m
